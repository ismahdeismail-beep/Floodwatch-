# ═══════════════════════════════════════════════════════════════
# FloodWatch AI — Environment Configuration
# Copy to .env and fill in real credentials. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Core ───────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=INFO

# ── Databases ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=floodwatch
POSTGRES_PASSWORD=floodwatch_dev
POSTGRES_DB=floodwatch
DATABASE_URL=postgresql://floodwatch:floodwatch_dev@localhost:5432/floodwatch
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO dev / GCS prod) ─────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=floodwatch
MINIO_SECRET_KEY=floodwatch_dev
MINIO_BUCKET=floodwatch-data

# ── API Gateway ────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
SERVICE_AUTH_URL=http://auth:8001
SERVICE_WEATHER_URL=http://weather:8002
SERVICE_HYDROLOGY_URL=http://hydrology:8003
SERVICE_SATELLITE_URL=http://satellite:8004
SERVICE_GIS_URL=http://gis:8005
SERVICE_AI_URL=http://ai:8006
SERVICE_ALERTS_URL=http://alerts:8007
SERVICE_ANALYTICS_URL=http://analytics:8008

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Weather providers ──────────────────────────────────────────
KMD_API_KEY=
OPENWEATHER_API_KEY=
METEOSTAT_API_KEY=
ECMWF_API_KEY=

# ── Hydrology ──────────────────────────────────────────────────
GLOFAS_API_URL=
GLOFAS_API_KEY=

# ── Satellite ──────────────────────────────────────────────────
NASA_GPM_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── Alert providers ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_BUSINESS_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVER_KEY=
APNS_KEY_ID=

# ── Hosting & data platforms ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NASA_EARTHDATA_TOKEN=
CDS_API_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

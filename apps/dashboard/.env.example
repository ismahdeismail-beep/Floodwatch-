# FloodWatch AI — Dashboard (Government Operations)
# Copy to .env.local and adjust.

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

# Map tiles (keyless demo tiles for development; use a Maplibre/Maptiler key in production)
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAPTILER_KEY=

# Default region monitored (Kenya)
NEXT_PUBLIC_DEFAULT_LAT=-1.2921
NEXT_PUBLIC_DEFAULT_LNG=36.8219
NEXT_PUBLIC_DEFAULT_ZOOM=6

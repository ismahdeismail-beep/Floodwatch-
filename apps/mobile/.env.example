# FloodWatch AI — Mobile App
# Copy to .env and adjust. Expo reads EXPO_PUBLIC_* variables at build time.

# API gateway (public URL in production, e.g. https://api.floodwatch.ai)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Map style — keyless demo tiles for development
EXPO_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Default center (Nairobi, Kenya)
EXPO_PUBLIC_DEFAULT_LAT=-1.2921
EXPO_PUBLIC_DEFAULT_LNG=36.8219

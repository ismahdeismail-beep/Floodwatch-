{
  "name": "floodwatch-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI-powered flood intelligence & early warning platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "stack:up": "docker compose up --build",
    "stack:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.0",
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "dependencies": {},
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}

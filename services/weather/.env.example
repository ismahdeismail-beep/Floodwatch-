# ═══ FloodWatch AI — weather service configuration ═══
# Copy into the repo-root .env or provide as container env vars.

LOG_LEVEL=INFO
KMD_API_KEY=
ECMWF_API_KEY=
NOAA_API_KEY=
OPENWEATHER_API_KEY=
METEOSTAT_API_KEY=
# Keyless provider; set to false to disable the always-available fallback.
OPEN_METEO_ENABLED=true
REDIS_URL=redis://localhost:6379/0
